{
  "name": "property-direct",
  "private": true,
  "version": "1.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite apps/ui",
    "build": "tsc -b && vite build apps/ui",
    "preview": "vite preview apps/ui",
    "tauri": "tauri",
    "lint": "eslint apps/ui/src packages apps/extension/src apps/extension/test/*.ts apps/web/src apps/mini",
    "lint:fix": "eslint apps/ui/src packages apps/extension/src apps/extension/test/*.ts apps/web/src apps/mini --fix",
    "typecheck": "tsc --noEmit && npm run typecheck -w @ghostly/core -w @ghostly/browser -w @ghostlytools/sdk -w @ghostly/extension -w @ghostly/web -w @ghostly/mini-chess -w @property/cli",
    "test": "npm run test:packages && npm run test:ui",
    "test:packages": "npm run test -w @ghostly/core -w @ghostly/browser -w @ghostlytools/sdk -w @ghostly/extension -w @ghostly/mini-chess -w @property/cli",
    "test:ui": "vitest run -c apps/ui/vitest.ui.config.ts",
    "build:extension": "npm run build -w @ghostly/extension",
    "build:cli": "npm run build -w @property/cli",
    "build:web": "npm run build -w @ghostly/web",
    "postinstall": "patch-package --patch-dir tools/patches",
    "build:sdk": "npm run build -w @ghostlytools/sdk",
    "test:group-load": "GROUP_LOAD=${GROUP_LOAD:-256} npm run test:group-load -w @ghostly/browser"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@emoji-mart/data": "^1.2.1",
    "@ghostly/browser": "*",
    "@ghostly/core": "*",
    "@ghostly/react": "*",
    "@noble/hashes": "2.4.0",
    "@qvac/langdetect-text": "0.1.3",
    "@scure/base": "2.4.0",
    "@scure/bip39": "^2.4.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "jsqr": "^1.4.0",
    "lowlight": "^3.3.0",
    "mediabunny": "^1.62.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@web5/dids": "1.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "patch-package": "8.0.1",
    "playwright": "^1.63.0",
    "solc": "0.8.37",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/*",
    "apps/extension",
    "apps/mini/*",
    "apps/web"
  ],
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    },
    "minimatch": "11.0.3",
    "zod": "4.6.7"
  }
}
