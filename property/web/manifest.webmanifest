{
  "name": "Property",
  "short_name": "Property",
  "description": "Property: Nostr communication with a local identity and relays you choose.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#090a0c",
  "theme_color": "#090a0c",
  "share_target": {
    "action": "./?launch=share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{
        "name": "files",
        "accept": ["image/*", "audio/*", "video/*", "text/*", "application/pdf", "application/zip", "application/octet-stream"]
      }]
    }
  },
  "shortcuts": [
    {"name":"New conversation","short_name":"New chat","description":"Start a private conversation in Property.","url":"./?launch=new-chat","icons":[{"src":"./assets/property-icon-192.png?v=property-v26","sizes":"192x192","type":"image/png"}]},
    {"name":"Marketplace","description":"Discover offers in Property.","url":"./?launch=marketplace","icons":[{"src":"./assets/property-icon-192.png?v=property-v26","sizes":"192x192","type":"image/png"}]},
    {"name":"Hangout","description":"Open the public Nostr feed in Property.","url":"./?launch=hangout","icons":[{"src":"./assets/property-icon-192.png?v=property-v26","sizes":"192x192","type":"image/png"}]}
  ],
  "icons": [
    {"src":"./assets/property-icon-192.png?v=property-v26","sizes":"192x192","type":"image/png","purpose":"any"},
    {"src":"./assets/property-icon-512.png?v=property-v26","sizes":"512x512","type":"image/png","purpose":"any maskable"},
    {"src":"./assets/icon.svg?v=property-v26","sizes":"any","type":"image/svg+xml","purpose":"any maskable"}
  ]
}
