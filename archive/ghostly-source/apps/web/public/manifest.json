{
  "name": "Property Direct",
  "short_name": "Property",
  "description": "Peer-to-peer conversations, calls and file sharing. No central messaging account.",
  "id": "/property/direct/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#090a0c",
  "theme_color": "#090a0c",
  "icons": [
    { "src": "property-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "property-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "property-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New chat", "short_name": "New chat", "description": "Start a chat and get its invite", "url": "./#/new", "icons": [{ "src": "property-icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Scan invite", "short_name": "Scan", "description": "Join a chat from its QR code", "url": "./#/scan", "icons": [{ "src": "property-icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Wallets", "short_name": "Wallets", "description": "Your wallets and payments", "url": "./#/wallet", "icons": [{ "src": "property-icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  },
  "protocol_handlers": [
    { "protocol": "web+property", "url": "./#%s" }
  ],
  "handle_links": "preferred",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] }
}
